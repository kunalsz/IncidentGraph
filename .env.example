# FalkorDB connection (docker-compose maps the container to host port 6380
# because 6379 is often taken by a local redis)
FALKORDB_HOST=localhost
FALKORDB_PORT=6380

# LLM provider: none | mock | openai | anthropic
#   none     - P0-P2 only; P3-P6 calls fail loudly (zero-LLM path unchanged)
#   mock     - deterministic rule-based provider, no key/network: tests, CI,
#              offline demos (implements the same typed output contracts)
#   openai   - ANY OpenAI-compatible endpoint; set LLM_BASE_URL for gateways
#              (e.g. River AI https://api.river.ai/v1)
#   anthropic- Anthropic messages API
#
# LLM_API_KEY may be a comma-separated list; calls rotate round-robin across
# the keys and a rate-limited (429) key falls over to the next one.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_API_KEYS=
LLM_MODEL=
LLM_MODEL_CHEAP=

# readonly = investigation writes go only to incidentgraph:session:* graphs
DEMO_MODE=readonly
