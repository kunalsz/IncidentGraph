# Copy to `.env` in the repository root. The file is read by CLI scripts,
# `make` targets, the test suite and the API service; variables already set in
# the shell always win, so an `export LLM_PROVIDER=mock` overrides this file.
#
# Nothing here is required: every setting has a working default (provider
# `none`, FalkorDB localhost:6380). The UI demo additionally needs a provider
# that is not `none`, see below.

# --- FalkorDB (CLI demo, engine, tests, evals) ------------------------------
# docker compose maps the container to host port 6380 because 6379 is often
# taken by a local redis.
FALKORDB_HOST=localhost
FALKORDB_PORT=6380

# --- Model provider ---------------------------------------------------------
#   none      - P0-P2 only; P3-P6 calls fail loudly (zero-LLM path unchanged)
#   mock      - deterministic rule-based provider, no key/network: tests, CI,
#               offline demos of every stage (same typed output contracts)
#   openai    - ANY OpenAI-compatible endpoint; set LLM_BASE_URL for gateways
#               (e.g. River AI https://api.river.ai/v1)
#   anthropic - Anthropic messages API
#
# The web service refuses to start a run while the provider is `none`.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_API_KEYS=
LLM_MODEL=
LLM_MODEL_CHEAP=
# Retries and rate-limit backoff for transient provider failures.
LLM_MAX_RETRIES=2
LLM_RATE_LIMIT_BACKOFF_S=5
# Accepted key aliases, used when LLM_API_KEY(S) is unset:
#   OPENAI_API_KEY / OPENAI_API_KEYS, ANTHROPIC_API_KEY / ANTHROPIC_API_KEYS

# --- Web service (server/ + web/) ------------------------------------------
# The UI runs real investigations, so it uses its own database rather than the
# demo graph. Start one with `make ui-db` (container `incidentgraph-ui-db`).
# Note: the service pins FALKORDB_HOST/PORT for its engine phases and reads
# these two variables instead - setting FALKORDB_PORT alone does not redirect it.
INCIDENTGRAPH_UI_DB_HOST=127.0.0.1
INCIDENTGRAPH_UI_DB_PORT=6381
# Comma-separated Host headers the callback/dashboard endpoints accept.
INCIDENTGRAPH_UI_ALLOWED_HOSTS=127.0.0.1,localhost
# Seconds between SSE heartbeats on /api/runs/{id}/stream.
INCIDENTGRAPH_UI_STREAM_HEARTBEAT_S=15

# --- Runtime ---------------------------------------------------------------
# deployment_mode: local | hosted. parallelism: concurrent P3 branches.
INCIDENTGRAPH_DEPLOYMENT_MODE=local
INCIDENTGRAPH_PARALLELISM=8

# --- Reserved --------------------------------------------------------------
# DEMO_MODE is not read by any code path today (kept for the intended
# read-only demo profile); investigation graphs are already isolated per run.
DEMO_MODE=readonly
