# FalkorDB connection (docker-compose maps the container to host port 6380
# because 6379 is often taken by a local redis)
FALKORDB_HOST=localhost
FALKORDB_PORT=6380

# LLM provider: none | anthropic | openai  (P0 works with none; Day 2 wires the loop)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=

# readonly = investigation writes go only to incidentgraph:session:* graphs
DEMO_MODE=readonly
