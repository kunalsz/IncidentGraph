    {"from": "service:checkoutservice", "to": "service:currencyservice"},
    {"from": "service:checkoutservice", "to": "service:emailservice"},
    {"from": "service:checkoutservice", "to": "service:paymentservice"},
    {"from": "service:checkoutservice", "to": "service:productcatalogservice"},
    {"from": "service:checkoutservice", "to": "service:shippingservice"},
    {"from": "service:recommendationservice", "to": "service:productcatalogservice"},
    {"from": "service:cartservice", "to": "service:redis"}
  ]
