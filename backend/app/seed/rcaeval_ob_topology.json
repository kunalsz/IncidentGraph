    {"id": "service:frontend", "name": "frontend", "aliases": ["frontendservice", "web", "ui"], "criticality": 0.95, "level": 1},
    {"id": "service:checkoutservice", "name": "checkoutservice", "aliases": ["checkout", "orders"], "criticality": 0.9, "level": 2},
    {"id": "service:cartservice", "name": "cartservice", "aliases": ["cart"], "criticality": 0.8, "level": 2},
    {"id": "service:productcatalogservice", "name": "productcatalogservice", "aliases": ["productcatalog", "catalog", "products"], "criticality": 0.7, "level": 2},
    {"id": "service:currencyservice", "name": "currencyservice", "aliases": ["currency", "fx"], "criticality": 0.6, "level": 2},
    {"id": "service:recommendationservice", "name": "recommendationservice", "aliases": ["recommendation", "recs"], "criticality": 0.6, "level": 2},
    {"id": "service:shippingservice", "name": "shippingservice", "aliases": ["shipping"], "criticality": 0.7, "level": 2},
    {"id": "service:adservice", "name": "adservice", "aliases": ["ads"], "criticality": 0.5, "level": 2},
    {"id": "service:paymentservice", "name": "paymentservice", "aliases": ["payment", "billing"], "criticality": 0.8, "level": 3},
    {"id": "service:emailservice", "name": "emailservice", "aliases": ["email"], "criticality": 0.4, "level": 3},
    {"id": "service:redis", "name": "redis", "aliases": ["redis-cart", "cart store"], "criticality": 0.6, "level": 3},
    {"id": "service:istio-init", "name": "istio-init", "aliases": ["sidecar init"], "criticality": 0.1, "level": 4}
  ],
  "depends_on": [
