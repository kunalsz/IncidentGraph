  "runbooks": [
    {
      "id": "runbook:payment-failures",
      "title": "Payment service failures / checkout errors",
      "applies_to": ["service:payment"],
      "params": [
        {"id": "param:payment-primary", "name": "payment_primary", "kind": "db"},
        {"id": "param:payment-replicas", "name": "replica_count", "kind": "cluster"}
      ],
      "steps": [
        {
          "step": 1,
          "action": "Check payment error rate and connection health",
          "validate_cmd": "kubectl get pods -l app=payment -o wide",
          "risk": "read-only",
          "undo": "none"
        },
        {
          "step": 2,
          "action": "If flag paymentFailure or paymentUnreachable is enabled, disable it in flagd",
          "validate_cmd": "kubectl get configmap flagd-config -o yaml | grep -A2 paymentFailure",
          "risk": "low - feature flag toggle",
          "undo": "re-enable the flag"
        },
        {
          "step": 3,
          "action": "If error rate remains, roll back the latest payment deployment",
          "validate_cmd": "kubectl rollout history deployment/payment",
          "risk": "medium - deployment rollback",
          "undo": "re-apply the rolled-back version"
        }
      ],
      "last_reviewed": 1789000000000
    },
    {
      "id": "runbook:cart-store-failures",
      "title": "Cart store / cart-cache failures",
      "applies_to": ["service:cart", "service:cart-cache"],
      "params": [
        {"id": "param:cart-store-endpoint", "name": "cart_store_endpoint", "kind": "db"}
      ],
      "steps": [
        {
          "step": 1,
          "action": "Check cart-cache (valkey) health and memory",
          "validate_cmd": "kubectl exec deploy/cart-cache -- valkey-cli info memory",
          "risk": "read-only",
          "undo": "none"
        },
        {
          "step": 2,
          "action": "If cartFailure flag is on, disable it",
          "validate_cmd": "kubectl get configmap flagd-config -o yaml | grep -A2 cartFailure",
          "risk": "low - feature flag toggle",
          "undo": "re-enable the flag"
        }
      ],
      "last_reviewed": 1789000000000
    },
    {
      "id": "runbook:recommendation-memory",
      "title": "Recommendation service slowdown / memory leak",
      "applies_to": ["service:recommendation"],
      "params": [
        {"id": "param:recs-cache-size", "name": "cache_max_size", "kind": "db"}
      ],
      "steps": [
        {
          "step": 1,
          "action": "Check recommendation memory usage trend (container_memory_working_set_bytes)",
          "validate_cmd": "kubectl top pods -l app=recommendation",
          "risk": "read-only",
          "undo": "none"
        },
        {
          "step": 2,
          "action": "If recommendationCacheFailure flag is on, disable it (leak scenario)",
          "validate_cmd": "kubectl get configmap flagd-config -o yaml | grep -A2 recommendationCacheFailure",
          "risk": "low - feature flag toggle",
          "undo": "re-enable the flag"
        },
        {
          "step": 3,
          "action": "Restart recommendation pods if memory is exhausted",
          "validate_cmd": "kubectl rollout status deployment/recommendation",
          "risk": "medium - service restart",
          "undo": "none (pods are stateless)"
        }
      ],
      "last_reviewed": 1789000000000
    },
    {
      "id": "runbook:kafka-backpressure",
      "title": "Kafka backpressure / consumer lag",
      "applies_to": ["service:kafka"],
      "params": [
        {"id": "param:kafka-brokers", "name": "broker_list", "kind": "cluster"}
      ],
      "steps": [
        {
          "step": 1,
          "action": "Check consumer group lag",
          "validate_cmd": "kubectl exec deploy/kafka -- kafka-consumer-groups.sh --describe --all-groups",
          "risk": "read-only",
          "undo": "none"
        }
      ],
      "last_reviewed": 1789000000000
    }
  ],
